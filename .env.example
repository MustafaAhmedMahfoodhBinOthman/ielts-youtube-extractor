PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
# Log verbosity: debug|info|warn|error (default info). Use debug for per-stage diagnostics.
LOG_LEVEL=info
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ielts-audio
R2_PUBLIC_URL=https://pub-<id>.r2.dev
# Optional: base64 of a Netscape cookies.txt exported from a logged-in browser.
# Generate: base64 -i cookies.txt | tr -d '\n'
YTDLP_COOKIES_B64=
# Optional: comma-separated CORS origins, e.g. https://admin.example.com.
# Empty = default deny: browser cross-origin requests are rejected 403;
# only same-origin (Origin host === Host) and non-browser clients
# (curl / server-side, no Origin header) are allowed.
ALLOWED_ORIGINS=
